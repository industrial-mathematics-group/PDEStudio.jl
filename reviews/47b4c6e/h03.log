--- UI tab path (_apply_editor_input!, as typing into the Plot style / axis page)
ok = true
(studio_state()).status = (text = "X Axis (1D) → tick_format = {:nope", level = :ok)
--- UI tab path, a value the type check now rejects for the API: line_width typed as 2 then 2.5
(m.ui[:plot_style])[:line_width] = 2
(m.ui[:plot_style])[:line_width] = 2.5
--- UI tab: plain text for a Symbol option (line_direction)
(m.ui[:plot_style])[:line_direction] = :horizontal
(studio_state()).status = (text = "'line_direction' was not changed: 'vertical' is not a valid value. Use numbers, :symbols, [vectors], (tuples) or \"text\" in quotes.", level = :warn)
--- API: line_direction "vertical" then does it draw vertically?
(studio_state()).status = (text = "Plot Style → line_direction = vertical", level = :ok)
--- Update Plot press after a failing option (the press handler's own status?)
studio_press!(:update_plot) = "Drawing failed: Unmatched { in format expression.. Change the style or options and Update Plot."
(studio_state()).status = (text = "Drawing failed: Unmatched { in format expression.. Change the style or options and Update Plot.", level = :error)
(studio_state()).status = (text = "Set t = 0.4.", level = :ok)
